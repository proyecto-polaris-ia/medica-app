{
  "name": "medica-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:local": "SUPABASE_LOCAL=1 vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/e2e-pretest.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "demo:seed": "docker exec -i supabase_db_medica-app psql -U postgres -d postgres -v ON_ERROR_STOP=1 < scripts/demo/seed-demo-data.sql",
    "demo:wipe": "docker exec -i supabase_db_medica-app psql -U postgres -d postgres -v ON_ERROR_STOP=1 < scripts/demo/remove-demo-data.sql",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "sanity": "node ../sanity-kit/src/cli.ts run",
    "sanity:fast": "node ../sanity-kit/src/cli.ts run --fast",
    "sanity:local": "SUPABASE_LOCAL=1 node ../sanity-kit/src/cli.ts run",
    "whatsapp:simulate": "node scripts/whatsapp-simulate-inbound.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.74",
    "@chat-adapter/state-memory": "^4.34.0",
    "@chat-adapter/whatsapp": "^4.34.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "2.109.0",
    "ai": "^7.0.93",
    "eve": "^0.52.2",
    "next": "15.5.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^29.1.1",
    "knip": "^6.39.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "undici": "^8.11.2",
    "jsdom": {
      "undici": "^7.30.0"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
