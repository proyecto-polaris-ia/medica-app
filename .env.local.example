# Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp inbound agent
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_HUMAN_ALERT_PHONE=
WHATSAPP_AGENT_LLM_API_KEY=
WHATSAPP_AGENT_LLM_MODEL=
WHATSAPP_AGENT_LLM_BASE_URL=
WHATSAPP_AGENT_LLM_API_STYLE=chat_completions

# AI Gateway key for the Eve agent (used via Vercel AI Gateway / OIDC)
AI_GATEWAY_API_KEY=

# WhatsApp agent routing switch (Stage 6)
# "true" (or "1"/"yes") routes inbound messages to the Eve agent;
# "false" (or unset) routes them to the legacy agent. Used for instant rollback.
WHATSAPP_EVE_ENABLED=false
