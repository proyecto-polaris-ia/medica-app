{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/page.{ts,tsx}",
    "app/**/layout.{ts,tsx}",
    "app/**/route.{ts,tsx}",
    "scripts/**"
  ],
  "project": ["app/**", "src/**", "scripts/**", "tests/**"],
  "ignoreBinaries": ["supabase"],
  "ignoreDependencies": ["eslint-config-next", "chat"],
  "ignoreExportsUsedInFile": true
}
